generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ROLE {
  admin
  manager
}

model Store {
  id String @id @default(uuid()) @map("_id") @db.ObjectId
  name String
  user_id String @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
}

model User {
  id String @id @default(uuid()) @map("_id") @db.ObjectId
  username String
  email String @unique
  role ROLE @default(manager)
  password String
  profile_image String? @default("https://github.com/shadcn.png")
  last_login DateTime?
  active Boolean? @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store[]
}

model Customer {
  id String @id @default(uuid()) @map("_id") @db.ObjectId
  username String
  email String @unique
  password String
  profile_image String? @default("https://github.com/shadcn.png")
  last_login DateTime?
  active Boolean? @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}