generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ROLE {
  admin
  customer
}

model User {
  id                String   @id @default(uuid())
  first_name        String?  @default("")
  last_name         String?  @default("")
  username          String   @unique
  email             String   @unique
  password          String
  role              ROLE     @default(customer)
  profile           String   @default("https://github.com/shadcn.png")
  is_email_verified Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  billboards Billboard[]
  Cart       Cart[]
}

model Billboard {
  id          String   @id @default(uuid())
  label       String
  image_url   String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user_id     String
  category_id String

  user     User     @relation(fields: [user_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])
}

model Category {
  id         String   @id @default(uuid())
  name       String
  icon       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  billboards Billboard[]
  product    Product[]
}

model Size {
  id         String   @id @default(uuid())
  name       String
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  productVariant ProductVariant[]
  Cart           Cart[]
  CartItem       CartItem[]
}

model Color {
  id         String   @id @default(uuid())
  name       String
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  productVariant ProductVariant[]
  Cart           Cart[]
  CartItem       CartItem[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  is_featured Boolean
  is_archived Boolean
  images      String[]
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  category_id String

  category       Category         @relation(fields: [category_id], references: [id])
  productVariant ProductVariant[]
}

model ProductVariant {
  id         String   @id @default(uuid())
  product_id String
  size_id    String
  color_id   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  size    Size     @relation(fields: [size_id], references: [id])
  color   Color    @relation(fields: [color_id], references: [id])
  product Product? @relation(fields: [product_id], references: [id])
}

model Cart {
  id       String  @id @default(uuid())
  user_id  String
  total    Float
  size_id  String?
  color_id String?

  cartItems CartItem[]
  user      User?      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  size      Size?      @relation(fields: [size_id], references: [id])
  color     Color?     @relation(fields: [color_id], references: [id])
}

model CartItem {
  id         String @id @default(uuid())
  product_id String
  quantity   Int
  color_id   String
  size_id    String
  cart_id    String

  size  Size?  @relation(fields: [size_id], references: [id])
  color Color? @relation(fields: [color_id], references: [id])
  cart  Cart   @relation(fields: [cart_id], references: [id])
}
